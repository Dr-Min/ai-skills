{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinema-studio-pipeline.local/schemas/v2/storyboard.schema.json",
  "$comment": "MANDATORY: review state and approval identity live only in the central approval record. When a central STORYBOARD approval with status USER_REVIEW_REQUIRED or USER_APPROVED targets these exact bytes, the semantic validator must require a non-null story_dependency, at least one asset, scene, panel, and shot; verify every panel image_file against image_sha256; require approval evidence to include the complete storyboard.json plus every current panel image; and enforce all ID/order/cross-link/duration rules. Do not mutate this content authority after hashing it for review. Storyboard review does not require approved asset records: ASSET_LOCK later requires one current USER_APPROVED asset record for every asset_plan item.",
  "title": "Cinema Studio Project Storyboard Authority Record",
  "description": "One project-wide authoritative inventory of planned assets, scenes, timed panels, shots, and coverage requirements.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "project_id",
    "storyboard_id",
    "version",
    "rough_level",
    "story_dependency",
    "asset_plan",
    "scenes",
    "shot_plan"
  ],
  "properties": {
    "$schema": { "type": "string", "pattern": "^(?:\\.\\./)*(?:00_schemas|schemas)/storyboard\\.schema\\.json$" },
    "schema_id": { "const": "cinema-studio-pipeline/storyboard@2.0.0" },
    "schema_version": { "const": "2.0.0" },
    "project_id": { "$ref": "#/$defs/projectId" },
    "storyboard_id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$" },
    "version": { "type": "integer", "minimum": 1 },
    "rough_level": { "type": "integer", "minimum": 1, "maximum": 4 },
    "story_dependency": {
      "oneOf": [{ "$ref": "#/$defs/storyDependency" }, { "type": "null" }]
    },
    "asset_plan": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/assetPlanItem" }
    },
    "scenes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/scene" }
    },
    "shot_plan": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/shotPlanItem" }
    },
    "notes": { "type": "string" }
  },
  "$defs": {
    "projectId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "sceneId": { "type": "string", "pattern": "^S[0-9]{2,4}$" },
    "shotId": { "type": "string", "pattern": "^S[0-9]{2,4}_SH[0-9]{3,4}$" },
    "panelId": { "type": "string", "pattern": "^S[0-9]{2,4}_P[0-9]{3,4}$" },
    "coverageId": { "type": "string", "pattern": "^COV_[A-Z0-9]+(?:_[A-Z0-9]+)*$" },
    "assetId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$" },
    "approvalId": { "type": "string", "pattern": "^APR_[A-Z0-9_]+_[0-9]{3,4}$" },
    "assetKind": {
      "enum": ["CHARACTER", "LOCATION", "PROP", "WARDROBE", "VEHICLE", "CREATURE", "VOICE", "AUDIO", "MOTION_REFERENCE", "STYLE_REFERENCE"]
    },
    "storyDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approval_id", "path", "sha256"],
      "properties": {
        "approval_id": { "$ref": "#/$defs/approvalId" },
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "assetPlanItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "kind", "state_label", "purpose"],
      "properties": {
        "asset_id": { "$ref": "#/$defs/assetId" },
        "kind": { "$ref": "#/$defs/assetKind" },
        "state_label": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" },
        "purpose": { "type": "string", "minLength": 1 }
      }
    },
    "activeAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "role"],
      "properties": {
        "asset_id": { "$ref": "#/$defs/assetId" },
        "role": {
          "enum": ["IDENTITY", "WARDROBE", "STATE", "LOCATION_GEOMETRY", "MATERIAL_LIGHT", "PROP_FUNCTION", "MOTION", "AUDIO", "STYLE"]
        },
        "state_label": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shot_size", "angle", "movement"],
      "properties": {
        "shot_size": {
          "enum": ["EXTREME_WIDE", "WIDE", "MEDIUM_WIDE", "MEDIUM", "MEDIUM_CLOSE_UP", "CLOSE_UP", "EXTREME_CLOSE_UP", "INSERT", "POV"]
        },
        "angle": {
          "enum": ["EYE_LEVEL", "LOW", "HIGH", "DUTCH", "OVERHEAD", "GROUND_LEVEL", "OVER_SHOULDER", "REAR_VIEW", "CUSTOM"]
        },
        "movement": {
          "enum": ["LOCKED", "STATIC_HANDHELD", "PAN", "TILT", "DOLLY", "TRACK", "CRANE", "ORBIT", "PUSH_IN", "PULL_OUT", "RACK_FOCUS", "CUSTOM"]
        },
        "fov_degrees": { "type": "number", "minimum": 1, "maximum": 180 },
        "composition": { "type": "string" }
      }
    },
    "panel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "panel_id",
        "order",
        "duration_hint_seconds",
        "story_beat",
        "action",
        "camera",
        "active_assets",
        "image_file",
        "image_sha256"
      ],
      "properties": {
        "panel_id": { "$ref": "#/$defs/panelId" },
        "order": { "type": "integer", "minimum": 1 },
        "duration_hint_seconds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "preferred", "maximum"],
          "properties": {
            "minimum": { "type": "number", "minimum": 0 },
            "preferred": { "type": "number", "minimum": 0 },
            "maximum": { "type": "number", "minimum": 0 }
          }
        },
        "story_beat": { "type": "string", "minLength": 1 },
        "action": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start_state", "end_state", "path"],
          "properties": {
            "start_state": { "type": "string", "minLength": 1 },
            "end_state": { "type": "string", "minLength": 1 },
            "path": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "description", "waypoints"],
              "properties": {
                "type": { "enum": ["STATIC", "SCREEN_DIRECTION", "BLOCKING_ROUTE", "CAMERA_RELATIVE", "CUSTOM"] },
                "description": { "type": "string" },
                "waypoints": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["order", "label", "screen_x", "screen_y", "depth"],
                    "properties": {
                      "order": { "type": "integer", "minimum": 1 },
                      "label": { "type": "string", "minLength": 1 },
                      "screen_x": { "type": "number", "minimum": 0, "maximum": 1 },
                      "screen_y": { "type": "number", "minimum": 0, "maximum": 1 },
                      "depth": { "enum": ["FOREGROUND", "MIDGROUND", "BACKGROUND"] }
                    }
                  }
                }
              }
            }
          }
        },
        "camera": { "$ref": "#/$defs/camera" },
        "active_assets": {
          "type": "array",
          "items": { "$ref": "#/$defs/activeAsset" }
        },
        "dialogue_or_audio_hint": { "type": ["string", "null"] },
        "transition_out": {
          "type": ["string", "null"],
          "enum": [null, "CUT", "MATCH_CUT", "DISSOLVE", "FADE", "WHIP", "NONE"]
        },
        "image_file": {
          "oneOf": [{ "$ref": "#/$defs/relativePath" }, { "type": "null" }]
        },
        "image_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene_id", "order", "panels"],
      "properties": {
        "scene_id": { "$ref": "#/$defs/sceneId" },
        "order": { "type": "integer", "minimum": 1 },
        "scene_purpose": { "type": "string", "minLength": 1 },
        "panels": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/panel" }
        }
      }
    },
    "coverageRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverage_id", "kind", "description", "minimum_approved_takes"],
      "properties": {
        "coverage_id": { "$ref": "#/$defs/coverageId" },
        "kind": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*$" },
        "description": { "type": "string", "minLength": 1 },
        "minimum_approved_takes": { "type": "integer", "minimum": 1 }
      }
    },
    "shotPlanItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shot_id",
        "scene_id",
        "order",
        "storyboard_panel_ids",
        "required_asset_ids",
        "coverage_requirements"
      ],
      "properties": {
        "shot_id": { "$ref": "#/$defs/shotId" },
        "scene_id": { "$ref": "#/$defs/sceneId" },
        "order": { "type": "integer", "minimum": 1 },
        "storyboard_panel_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/panelId" }
        },
        "required_asset_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/assetId" }
        },
        "coverage_requirements": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/coverageRequirement" }
        }
      }
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))(?![A-Za-z]:)(?![\\\\/]).+$"
    }
  }
}
